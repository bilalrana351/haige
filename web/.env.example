# Copy to .env.local and fill in. Never commit .env.local.

# WorkOS (dashboard.workos.com > API Keys)
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...

# 32+ characters, used to encrypt the session cookie. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Must match a redirect URI configured in the WorkOS dashboard (Applications > Redirects).
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Base URL of haige-api. Optional: when unset, the web app does not call the API.
HAIGE_API_URL=http://localhost:8787
